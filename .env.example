# Copy to .env and fill in. Never commit .env.

# Local LLM server (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=huggingface.co/QuantFactory/finance-Llama3-8B-GGUF:Q5_K_M

# CIO agent (hosted LLM via Groq)
